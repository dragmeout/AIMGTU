{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIMGTU knowledge chunk v2",
  "type": "object",
  "required": ["document_id", "document_title", "source", "date", "document_type", "department", "page", "chunk_id", "text", "pages", "chunking_method", "clean_sha256", "raw_sha256", "validity_status", "allowed_use"],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "document_title": {"type": "string", "minLength": 1},
    "source": {"type": "string", "format": "uri"},
    "date": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "date_basis": {"type": "string"},
    "fetched_at": {"type": "string", "format": "date-time"},
    "document_type": {"type": "string"},
    "department": {"type": "string"},
    "page": {"type": ["integer", "null"], "minimum": 1},
    "page_end": {"type": ["integer", "null"], "minimum": 1},
    "pages": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
    "page_precision": {"enum": ["containing_block_page_span", "not_applicable_html"]},
    "chunk_id": {"type": "string", "minLength": 1},
    "text": {"type": "string", "minLength": 1},
    "chunking_method": {"enum": ["fixed", "semantic"]},
    "section_paths": {"type": "array", "items": {"type": "array", "items": {"type": "string"}}},
    "block_ids": {"type": "array", "items": {"type": "string"}},
    "word_count": {"type": "integer", "minimum": 1, "maximum": 260},
    "start_char": {"type": "integer", "minimum": 0},
    "end_char": {"type": "integer", "minimum": 1},
    "fallback_split": {"type": "boolean"},
    "source_priority": {"type": "integer", "minimum": 1, "maximum": 5},
    "dynamic": {"type": "boolean"},
    "validity_status": {"type": "string"},
    "allowed_use": {"enum": ["navigation_only", "navigation_and_snapshot_reference", "dated_reference_not_current_rule"]},
    "clean_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "raw_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "retrieval_text": {"type": "string"}
  },
  "additionalProperties": true
}
